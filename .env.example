# Local execution.
HOST=127.0.0.1
PORT=4317
PYTHON_BIN=.venv/bin/python
# BASIRA_DATA_DIR=/absolute/protected/path
# NODE_ENV=production requires HTTPS; demo defaults disabled there.

# Optional bounded Anthropic assistant transport (see docs/AI_INTEGRATION.md). All three
# must be set for it to activate; any one missing keeps the existing local evidence-only
# /api/assistant behavior with no network call attempted. Never sends financial amounts,
# raw documents, formulas, source coordinates or company/user identity to the model.
# BASIRA_AI_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
